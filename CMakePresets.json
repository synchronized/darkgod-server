{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "NINJA_STATUS": "[%f/%t] "
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "config-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "config-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "toolchain-clang-cl",
      "hidden": true,
      "inherits": "base-ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl"
      }
    },
    {
      "name": "platform-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "platform-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "platform-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "generator-vs2022",
      "hidden": true,
      "inherits": "platform-windows",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": "x64"
    },
    {
      "name": "windows-skyuv",
      "hidden": true,
      "inherits": "generator-vs2022",
      "cacheVariables": {
        "DARKGOD_BUILD_PACKAGE": true,
        "SKYUV_USE_SHARED_LIBUV": false,
        "SKYUV_BUILD_TESTS": false
      }
    },
    {
      "name": "windows-vs2022-debug",
      "displayName": "Windows x64 Visual Studio 2022 skyuv Debug",
      "inherits": "windows-skyuv"
    },
    {
      "name": "windows-vs2022-release",
      "displayName": "Windows x64 Visual Studio 2022 skyuv Release",
      "inherits": ["windows-skyuv", "config-release"]
    },
    {
      "name": "windows-clang-cl",
      "hidden": true,
      "inherits": ["platform-windows", "toolchain-clang-cl"],
      "cacheVariables": {
        "DARKGOD_BUILD_PACKAGE": true,
        "SKYUV_USE_SHARED_LIBUV": false,
        "SKYUV_BUILD_TESTS": false
      }
    },
    {
      "name": "windows-clang-cl-debug",
      "displayName": "Windows x64 clang-cl skyuv Debug",
      "inherits": ["windows-clang-cl", "config-debug"]
    },
    {
      "name": "windows-clang-cl-release",
      "displayName": "Windows x64 clang-cl skyuv Release",
      "inherits": ["windows-clang-cl", "config-release"]
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC skyuv Debug",
      "inherits": ["base-ninja", "platform-linux", "config-debug"]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC skyuv Release",
      "inherits": ["base-ninja", "platform-linux", "config-release"]
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang skyuv Debug",
      "inherits": ["base-ninja", "platform-macos", "config-debug"]
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS Clang skyuv Release",
      "inherits": ["base-ninja", "platform-macos", "config-release"]
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-cl-debug",
      "configurePreset": "windows-clang-cl-debug"
    },
    {
      "name": "windows-clang-cl-release",
      "configurePreset": "windows-clang-cl-release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-release",
      "configurePreset": "macos-clang-release"
    }
  ]
}
